#!/usr/bin/env bash
# Fails if any Docker network sits in 172.16.0.0/12 — the range CIn (and the
# strongSwan VPN) use internally. Such a bridge installs a scope-link /16 that
# shadows the tunnel / wired route to *.cin.ufpe.br and connections time out.
#
# Run manually, from CI, or as a systemd unit after docker.service.
set -euo pipefail

bad=0
while read -r name subnets; do
    for s in $subnets; do
        case "$s" in
            172.1[6-9].*|172.2[0-9].*|172.3[01].*)
                echo "BAD  $name  ->  $s"
                bad=1
                ;;
        esac
    done
done < <(docker network ls --format '{{.Name}}' | while read -r n; do
    printf '%s ' "$n"
    docker network inspect "$n" --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
done)

if [ "$bad" -ne 0 ]; then
    echo
    echo "One or more Docker networks are in 172.16.0.0/12. Recreate them:"
    echo "  docker compose -p <proj> down && docker compose -p <proj> up -d"
    echo "(default-address-pools in /etc/docker/daemon.json only affects NEW networks)"
    exit 1
fi

echo "OK — no Docker network in 172.16.0.0/12"
